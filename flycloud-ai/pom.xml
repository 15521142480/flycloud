<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <parent>
        <groupId>com.flycloud</groupId>
        <artifactId>flycloud-server</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>flycloud-ai</artifactId>
    <description>飞翔云-AI 服务</description>
    <modelVersion>4.0.0</modelVersion>
    <packaging>jar</packaging>

    <dependencies>
        <dependency>
            <groupId>com.flycloud</groupId>
            <artifactId>flycloud-common-code</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>com.flycloud</groupId>
            <artifactId>flycloud-common-doc</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- 统一聊天的会话与消息历史持久化。 -->
        <dependency>
            <groupId>com.flycloud</groupId>
            <artifactId>flycloud-common-database</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- Spring AI ChatMemory 的短期上下文存储。 -->
        <dependency>
            <groupId>com.flycloud</groupId>
            <artifactId>flycloud-common-redis</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- AI Tool Calling 需要复用统一登录态、Feign 签名与服务间调用规范。 -->
        <dependency>
            <groupId>com.flycloud</groupId>
            <artifactId>flycloud-common-security</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>com.flycloud</groupId>
            <artifactId>flycloud-common-feign</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>com.flycloud</groupId>
            <artifactId>flycloud-system-api</artifactId>
            <version>${revision}</version>
            <exclusions>
                <!-- AI 只使用系统 Feign 接口和 VO，不应因 API 模块的传递依赖初始化本地数据源。 -->
                <exclusion>
                    <groupId>com.flycloud</groupId>
                    <artifactId>flycloud-common-database</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.flycloud</groupId>
            <artifactId>flycloud-mall-api</artifactId>
            <version>${revision}</version>
            <exclusions>
                <!-- AI 只使用商城 Feign 接口和 VO，不应因 API 模块的传递依赖初始化本地数据源。 -->
                <exclusion>
                    <groupId>com.flycloud</groupId>
                    <artifactId>flycloud-common-database</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- 注册中心与配置中心客户端 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- Spring AI 流式 API 使用 Reactor；与 MVC 同时存在时仍以 MVC 作为 Web 应用类型。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>
        <!-- OpenAI 协议适配器：可连接 ChatGPT，也可连接阿里云百炼等兼容服务。 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>
        <!-- DeepSeek 官方 Spring AI 适配器。 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-deepseek</artifactId>
        </dependency>
        <!-- 正式向量存储：EmbeddingModel 生成向量后写入 Qdrant。 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-vector-store-qdrant</artifactId>
        </dependency>
        <!-- 内部 MCP Server 与 Client，使用当前 Spring AI 版本的 Streamable HTTP 传输。 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-client</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
