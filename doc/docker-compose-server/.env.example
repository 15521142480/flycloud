# 项目目录：生产环境默认将本目录整体放在 /project/flycloud-service
PROJECT_DIR=/project/flycloud-service
COMPOSE_PROJECT_NAME=flycloud-server
COMPOSE_NETWORK_NAME=flycloud-server
TZ=Asia/Shanghai

# 镜像和容器日志
IMAGE_TAG=latest
DOCKER_LOG_MAX_SIZE=20m
DOCKER_LOG_MAX_FILE=5
STOP_GRACE_PERIOD=30s
STOP_TIMEOUT_SECONDS=30

# Dockerfile 中应用用户的 UID/GID
APP_UID=10001
APP_GID=10001
LOG_DIR_MODE=0750

# true：构建时拉取最新基础镜像；默认关闭，保证部署结果更稳定
PULL_BASE_IMAGES=false

# true：递归修复已有日志的属主；默认关闭，避免每次部署扫描历史日志
REPAIR_LOG_OWNERSHIP=false

# JVM 参数按服务独立设置。配置容器内存限制后，再设置 MaxRAMPercentage 等参数。
FLYCLOUD_GATEWAY_JAVA_OPTS=
FLYCLOUD_AUTH_JAVA_OPTS=
FLYCLOUD_SYSTEM_JAVA_OPTS=
FLYCLOUD_BPM_JAVA_OPTS=
FLYCLOUD_MALL_JAVA_OPTS=
FLYCLOUD_AI_JAVA_OPTS=

# flycloud-ai：只填写实际启用的模型供应商密钥；不要提交真实值到 Git。
DASHSCOPE_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
